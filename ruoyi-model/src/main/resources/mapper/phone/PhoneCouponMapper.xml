<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.phone.mapper.PhoneCouponMapper">

    <resultMap type="PhoneCoupon" id="PhoneCouponResult">
        <result property="id"    column="id"    />
        <result property="companyId"    column="company_id"    />
        <result property="appId"    column="app_id"    />
        <result property="title"    column="title"    />
        <result property="termValidity"    column="term_validity"    />
        <result property="fullMoney"    column="full_money"    />
        <result property="minusMoney"    column="minus_money"    />
        <result property="distributionMode"    column="distribution_mode"    />
        <result property="number"    column="number"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectPhoneCouponVo">
        select
            id,
            company_id,
            app_id,
            title,
            term_validity,
            full_money,
            minus_money,
            distribution_mode,
            number,
            status,
            create_by,
            create_time,
            update_by,
            update_time,
            remark
        from phone_coupon
    </sql>

    <select id="selectPhoneCouponList" parameterType="PhoneCoupon" resultMap="PhoneCouponResult">
        <include refid="selectPhoneCouponVo"/>
        <where>
            <if test="companyId != null "> and company_id = #{companyId}</if>
            <if test="appId != null  and appId != ''"> and app_id = #{appId}</if>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="termValidity != null "> and term_validity = #{termValidity}</if>
            <if test="fullMoney != null "> and full_money = #{fullMoney}</if>
            <if test="minusMoney != null "> and minus_money = #{minusMoney}</if>
            <if test="distributionMode != null  and distributionMode != ''"> and distribution_mode = #{distributionMode}</if>
            <if test="number != null "> and number = #{number}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectPhoneCouponById" parameterType="Long" resultMap="PhoneCouponResult">
        <include refid="selectPhoneCouponVo"/>
        where id = #{id}
    </select>

    <insert id="insertPhoneCoupon" parameterType="PhoneCoupon" useGeneratedKeys="true" keyProperty="id">
        insert into phone_coupon
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="companyId != null">company_id,</if>
            <if test="appId != null">app_id,</if>
            <if test="title != null">title,</if>
            <if test="termValidity != null">term_validity,</if>
            <if test="fullMoney != null">full_money,</if>
            <if test="minusMoney != null">minus_money,</if>
            <if test="distributionMode != null">distribution_mode,</if>
            <if test="number != null">number,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="companyId != null">#{companyId},</if>
            <if test="appId != null">#{appId},</if>
            <if test="title != null">#{title},</if>
            <if test="termValidity != null">#{termValidity},</if>
            <if test="fullMoney != null">#{fullMoney},</if>
            <if test="minusMoney != null">#{minusMoney},</if>
            <if test="distributionMode != null">#{distributionMode},</if>
            <if test="number != null">#{number},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePhoneCoupon" parameterType="PhoneCoupon">
        update phone_coupon
        <trim prefix="SET" suffixOverrides=",">
            <if test="companyId != null">company_id = #{companyId},</if>
            <if test="appId != null">app_id = #{appId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="termValidity != null">term_validity = #{termValidity},</if>
            <if test="fullMoney != null">full_money = #{fullMoney},</if>
            <if test="minusMoney != null">minus_money = #{minusMoney},</if>
            <if test="distributionMode != null">distribution_mode = #{distributionMode},</if>
            <if test="number != null">number = #{number},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePhoneCouponById" parameterType="Long">
        delete from phone_coupon where id = #{id}
    </delete>

    <delete id="deletePhoneCouponByIds" parameterType="String">
        delete from phone_coupon where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>