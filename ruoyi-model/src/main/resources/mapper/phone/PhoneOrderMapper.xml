    <select id="getOrderCount" parameterType="phoneOrder" resultType="integer">
        SELECT count(a.id) FROM phone_order a
        left join sys_dept d on a.dept_id = d.dept_id
        <where>
            a.pay_status = '2'
            <if test="appId != null and appId != ''">
                AND a.app_id = #{appId}
            </if>
            <if test="params.type != null and params.type != ''">
                <choose>
                    <when test="params.type == '1'.toString">
                        AND TO_DAYS(NOW()) - TO_DAYS(a.create_time) = 0
                    </when>
                    <when test="params.type == '2'.toString">
                        AND TO_DAYS(NOW()) - TO_DAYS(a.create_time) = 1
                    </when>
                    <when test="params.type == '3'.toString">
                        AND DATE_FORMAT(a.create_time, '%Y%m') = DATE_FORMAT(CURDATE(), '%Y%m')
                    </when>
                </choose>
            </if>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>
    </select>

    <select id="getOrderCountMoney" parameterType="phoneOrder" resultType="decimal">
        SELECT IFNULL(sum(a.money),0) FROM phone_order a
        left join sys_dept d on a.dept_id = d.dept_id
        <where>
            a.pay_status = '2'
            <if test="appId != null and appId != ''">
                AND a.app_id = #{appId}
            </if>
            <if test="params.type != null and params.type != ''">
                <choose>
                    <when test="params.type == '1'.toString">
                        AND TO_DAYS(NOW()) - TO_DAYS(a.create_time) = 0
                    </when>
                    <when test="params.type == '2'.toString">
                        AND TO_DAYS(NOW()) - TO_DAYS(a.create_time) = 1
                    </when>
                    <when test="params.type == '3'.toString">
                        AND DATE_FORMAT(a.create_time, '%Y%m') = DATE_FORMAT(CURDATE(), '%Y%m')
                    </when>
                </choose>
            </if>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>
    </select>

    <select id="getDayOrderCountMoney" parameterType="phoneOrder" resultType="java.util.Map">
        SELECT DATE_FORMAT(a.create_time,'%Y-%m-%d') days,IFNULL(sum(a.money),0) money
        FROM phone_order a
        left join sys_dept d on a.dept_id = d.dept_id
        <where>
            a.pay_status = '2'
            AND DATE_FORMAT(a.create_time, '%Y-%m') = DATE_FORMAT(CURRENT_DATE, '%Y-%m')
            <if test="appId != null and appId != ''">
                AND a.app_id = #{appId}
            </if>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>
        group by days
    </select>

    <select id="getMonthOrderCountMoney" parameterType="phoneOrder" resultType="java.util.Map">
        SELECT DATE_FORMAT(a.create_time,'%Y-%m') months,IFNULL(sum(a.money),0) money
        FROM phone_order a
        left join sys_dept d on a.dept_id = d.dept_id
        <where>
            a.pay_status = '2'
            AND  YEAR(a.create_time) = YEAR(NOW())
            <if test="appId != null and appId != ''">
                AND a.app_id = #{appId}
            </if>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>
        group by months
    </select>

