    <delete id="deletePhoneOrderById" parameterType="Long">
        delete from phone_order where id = #{id}
    </delete>

    <delete id="deletePhoneOrderByIds" parameterType="String">
        delete from phone_order where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
