    <sql id="selectPhoneOrderVo">
        select
            a.id,
            a.dept_id,
            a.app_id,
            a.member_id,
            a.price_id,
            a.coupon_id,
            a.order_no,
            a.method,
            a.type,
            a.mobile,
            a.account_number,
            a.residence_type,
            a.area,
            a.card_no,
            a.top_up_money,
            a.money,
            a.pay_money,
            a.pay_balance,
               a.refund_money,
            a.pay_type,
            a.pay_status,
            a.arrival_status,
            a.pay_time,
            a.pay_result,
               a.top_result,
               a.top_time,
               a.top_notify_result,
            a.create_by,
            a.create_time,
            a.update_by,
            a.update_time,
            a.remark,
            wc.title as wxTitle,
            m.name AS memberName,
            m.avatar AS memberAvatar,
            m.number,
            m.mobile AS memberMobile,
            m.sex,
            m.birthday,
            m.balance,
            m.open_id,
            m.is_member,
            p.method AS priceMethod,
            p.type AS priceType,
            p.type_id,
            p.original_price,
            p.discount,
            p.sell_price,
            p.member_price,
            p.direct_commission,
            p.indirect_commission,
            p.member_direct_commission,
            p.member_indirect_commission,
            p.super_member_direct_commission,
            p.super_member_indirect_commission,
            p.order_num,
            t.title AS typeTitle,
            t.status AS typeStatus,
            t.order_num AS typeOrderNum
        from phone_order a
                 left join phone_wechat_config wc ON wc.app_id = a.app_id
                 left join phone_member m ON m.id = a.member_id
                left join phone_price p ON p.id = a.price_id
                 left join phone_price_type t ON t.id = p.type_id
                 left join sys_dept d on a.dept_id = d.dept_id
    </sql>

