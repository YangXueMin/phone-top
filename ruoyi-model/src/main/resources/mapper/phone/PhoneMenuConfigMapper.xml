<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.phone.mapper.PhoneMenuConfigMapper">

    <resultMap type="PhoneMenuConfig" id="PhoneMenuConfigResult">
        <result property="id"    column="id"    />
        <result property="companyId"    column="company_id"    />
        <result property="appId"    column="app_id"    />
        <result property="title"    column="title"    />
        <result property="url"    column="url"    />
        <result property="status"    column="status"    />
        <result property="orderNum"    column="order_num"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <association property="wechatConfig"    column="app_id" javaType="WechatConfig" resultMap="WechatConfigResult" />
    </resultMap>

    <resultMap type="WechatConfig" id="WechatConfigResult">
        <result property="title"    column="wxTitle"    />
    </resultMap>


    <sql id="selectPhoneMenuConfigVo">
        select
            a.id,
            a.company_id,
            a.app_id,
            a.title,
            a.url,
            a.status,
            a.order_num,
            a.create_by,
            a.create_time,
            a.update_by,
            a.update_time,
            a.remark,
            wc.title as wxTitle
        from phone_menu_config a
                 left join phone_wechat_config wc ON wc.app_id = a.app_id
    </sql>

    <select id="selectPhoneMenuConfigList" parameterType="PhoneMenuConfig" resultMap="PhoneMenuConfigResult">
        <include refid="selectPhoneMenuConfigVo"/>
        <where>
            <if test="companyId != null "> and a.company_id = #{companyId}</if>
            <if test="appId != null  and appId != ''"> and a.app_id = #{appId}</if>
            <if test="title != null  and title != ''"> and a.title = #{title}</if>
            <if test="url != null  and url != ''"> and a.url = #{url}</if>
            <if test="status != null  and status != ''"> and a.status = #{status}</if>
            <if test="orderNum != null "> and a.order_num = #{orderNum}</if>
        </where>
    </select>

    <select id="selectPhoneMenuConfigById" parameterType="Long" resultMap="PhoneMenuConfigResult">
        <include refid="selectPhoneMenuConfigVo"/>
        where a.id = #{id}
    </select>

    <insert id="insertPhoneMenuConfig" parameterType="PhoneMenuConfig" useGeneratedKeys="true" keyProperty="id">
        insert into phone_menu_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="companyId != null">company_id,</if>
            <if test="appId != null">app_id,</if>
            <if test="title != null">title,</if>
            <if test="url != null">url,</if>
            <if test="status != null">status,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="companyId != null">#{companyId},</if>
            <if test="appId != null">#{appId},</if>
            <if test="title != null">#{title},</if>
            <if test="url != null">#{url},</if>
            <if test="status != null">#{status},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePhoneMenuConfig" parameterType="PhoneMenuConfig">
        update phone_menu_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="companyId != null">company_id = #{companyId},</if>
            <if test="appId != null">app_id = #{appId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="url != null">url = #{url},</if>
            <if test="status != null">status = #{status},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePhoneMenuConfigById" parameterType="Long">
        delete from phone_menu_config where id = #{id}
    </delete>

    <delete id="deletePhoneMenuConfigByIds" parameterType="String">
        delete from phone_menu_config where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>