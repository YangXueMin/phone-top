<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.phone.mapper.PhoneCommissionConfigMapper">

    <resultMap type="PhoneCommissionConfig" id="PhoneCommissionConfigResult">
        <result property="id"    column="id"    />
        <result property="companyId"    column="company_id"    />
        <result property="appId"    column="app_id"    />
        <result property="memberId"    column="member_id"    />
        <result property="commissionBefore"    column="commission_before"    />
        <result property="money"    column="money"    />
        <result property="commissionAfter"    column="commission_after"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectPhoneCommissionConfigVo">
        select
            id,
            company_id,
            app_id,
            member_id,
            commission_before,
            money,
            commission_after,
            create_by,
            create_time,
            update_by,
            update_time,
            remark
        from phone_commission_config
    </sql>

    <select id="selectPhoneCommissionConfigList" parameterType="PhoneCommissionConfig" resultMap="PhoneCommissionConfigResult">
        <include refid="selectPhoneCommissionConfigVo"/>
        <where>
            <if test="companyId != null "> and company_id = #{companyId}</if>
            <if test="appId != null "> and app_id = #{appId}</if>
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <if test="commissionBefore != null "> and commission_before = #{commissionBefore}</if>
            <if test="money != null "> and money = #{money}</if>
            <if test="commissionAfter != null "> and commission_after = #{commissionAfter}</if>
        </where>
    </select>

    <select id="selectPhoneCommissionConfigById" parameterType="Long" resultMap="PhoneCommissionConfigResult">
        <include refid="selectPhoneCommissionConfigVo"/>
        where id = #{id}
    </select>

    <insert id="insertPhoneCommissionConfig" parameterType="PhoneCommissionConfig" useGeneratedKeys="true" keyProperty="id">
        insert into phone_commission_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="companyId != null">company_id,</if>
            <if test="appId != null">app_id,</if>
            <if test="memberId != null">member_id,</if>
            <if test="commissionBefore != null">commission_before,</if>
            <if test="money != null">money,</if>
            <if test="commissionAfter != null">commission_after,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="companyId != null">#{companyId},</if>
            <if test="appId != null">#{appId},</if>
            <if test="memberId != null">#{memberId},</if>
            <if test="commissionBefore != null">#{commissionBefore},</if>
            <if test="money != null">#{money},</if>
            <if test="commissionAfter != null">#{commissionAfter},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePhoneCommissionConfig" parameterType="PhoneCommissionConfig">
        update phone_commission_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="companyId != null">company_id = #{companyId},</if>
            <if test="appId != null">app_id = #{appId},</if>
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="commissionBefore != null">commission_before = #{commissionBefore},</if>
            <if test="money != null">money = #{money},</if>
            <if test="commissionAfter != null">commission_after = #{commissionAfter},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePhoneCommissionConfigById" parameterType="Long">
        delete from phone_commission_config where id = #{id}
    </delete>

    <delete id="deletePhoneCommissionConfigByIds" parameterType="String">
        delete from phone_commission_config where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>