<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.phone.mapper.PhoneCommissionConfigMapper">

    <resultMap type="PhoneCommissionConfig" id="PhoneCommissionConfigResult">
        <result property="id"    column="id"    />
        <result property="deptId"    column="dept_id"    />
        <result property="appId"    column="app_id"    />
        <result property="memberId"    column="member_id"    />
        <result property="commissionMemberId"    column="commission_member_id"    />
        <result property="commissionBefore"    column="commission_before"    />
        <result property="money"    column="money"    />
        <result property="commissionAfter"    column="commission_after"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <association property="wechatConfig"    column="app_id" javaType="WechatConfig" resultMap="WechatConfigResult" />
        <association property="member"    column="member_id" javaType="Member" resultMap="MemberResult" />
    </resultMap>

    <resultMap type="WechatConfig" id="WechatConfigResult">
        <result property="title"    column="wxTitle"    />
    </resultMap>

    <resultMap type="Member" id="MemberResult">
        <result property="id"    column="member_id"    />
        <result property="name"    column="memberName"    />
        <result property="avatar"    column="memberAvatar"    />
        <result property="number"    column="number"    />
        <result property="mobile"    column="memberMobile"    />
        <result property="sex"    column="sex"    />
        <result property="birthday"    column="birthday"    />
        <result property="balance"    column="balance"    />
        <result property="openId"    column="open_id"    />
        <result property="isMember"    column="is_member"    />
    </resultMap>

    <sql id="selectPhoneCommissionConfigVo">
        select
            a.id,
            a.dept_id,
            a.app_id,
            a.member_id,
               a.commission_member_id,
            a.commission_before,
            a.money,
            a.commission_after,
            a.create_by,
            a.create_time,
            a.update_by,
            a.update_time,
            a.remark,
            wc.title as wxTitle,
            m.name AS memberName,
            m.avatar AS memberAvatar,
            m.number,
            m.mobile AS memberMobile,
            m.sex,
            m.birthday,
            m.balance,
            m.open_id,
            m.is_member
        from phone_commission_config  a
                 left join phone_wechat_config wc ON wc.app_id = a.app_id
                 left join phone_member m ON m.id = a.member_id
                 left join sys_dept d on a.dept_id = d.dept_id
    </sql>

    <select id="selectPhoneCommissionConfigList" parameterType="PhoneCommissionConfig" resultMap="PhoneCommissionConfigResult">
        <include refid="selectPhoneCommissionConfigVo"/>
        <where>
            <if test="deptId != null "> and a.dept_id = #{deptId}</if>
            <if test="appId != null "> and a.app_id = #{appId}</if>
            <if test="memberId != null "> and a.member_id = #{memberId}</if>
            <if test="commissionMemberId != null "> and a.commission_member_id = #{commissionMemberId}</if>
            <if test="commissionBefore != null "> and a.commission_before = #{commissionBefore}</if>
            <if test="money != null "> and a.money = #{money}</if>
            <if test="commissionAfter != null "> and a.commission_after = #{commissionAfter}</if>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>
        ORDER BY a.create_time DESC
    </select>

    <select id="selectPhoneCommissionConfigById" parameterType="Long" resultMap="PhoneCommissionConfigResult">
        <include refid="selectPhoneCommissionConfigVo"/>
        where a.id = #{id}
    </select>

    <insert id="insertPhoneCommissionConfig" parameterType="PhoneCommissionConfig" useGeneratedKeys="true" keyProperty="id">
        insert into phone_commission_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deptId != null">dept_id,</if>
            <if test="appId != null">app_id,</if>
            <if test="memberId != null">member_id,</if>
            <if test="commissionMemberId != null">commission_member_id,</if>
            <if test="commissionBefore != null">commission_before,</if>
            <if test="money != null">money,</if>
            <if test="commissionAfter != null">commission_after,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deptId != null">#{deptId},</if>
            <if test="appId != null">#{appId},</if>
            <if test="memberId != null">#{memberId},</if>
            <if test="commissionMemberId != null">#{commissionMemberId},</if>
            <if test="commissionBefore != null">#{commissionBefore},</if>
            <if test="money != null">#{money},</if>
            <if test="commissionAfter != null">#{commissionAfter},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePhoneCommissionConfig" parameterType="PhoneCommissionConfig">
        update phone_commission_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="appId != null">app_id = #{appId},</if>
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="commissionMemberId != null">commission_member_id = #{commissionMemberId},</if>
            <if test="commissionBefore != null">commission_before = #{commissionBefore},</if>
            <if test="money != null">money = #{money},</if>
            <if test="commissionAfter != null">commission_after = #{commissionAfter},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePhoneCommissionConfigById" parameterType="Long">
        delete from phone_commission_config where id = #{id}
    </delete>

    <delete id="deletePhoneCommissionConfigByIds" parameterType="String">
        delete from phone_commission_config where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>