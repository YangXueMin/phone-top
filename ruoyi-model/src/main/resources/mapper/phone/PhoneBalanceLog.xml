<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.phone.mapper.PhoneBalanceLogMapper">

    <resultMap type="PhoneBalanceLog" id="PhoneBalanceLogResult">
        <result property="id"    column="id"    />
        <result property="companyId"    column="company_id"    />
        <result property="configId"    column="config_id"    />
        <result property="memberId"    column="member_id"    />
        <result property="type"    column="type"    />
        <result property="balanceBefore"    column="balance_before"    />
        <result property="money"    column="money"    />
        <result property="balanceAfter"    column="balance_after"    />
        <result property="payTime"    column="pay_time"    />
        <result property="payResult"    column="pay_result"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectPhoneBalanceLogVo">
        select
            id,
            company_id,
            config_id,
            member_id,
            type,
            balance_before,
            money,
            balance_after,
            pay_time,
            pay_result,
            create_by,
            create_time,
            update_by,
            update_time,
            remark
        from phone_balance_log
    </sql>

    <select id="selectPhoneBalanceLogList" parameterType="PhoneBalanceLog" resultMap="PhoneBalanceLogResult">
        <include refid="selectPhoneBalanceLogVo"/>
        <where>
            <if test="companyId != null "> and company_id = #{companyId}</if>
            <if test="configId != null "> and config_id = #{configId}</if>
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="balanceBefore != null "> and balance_before = #{balanceBefore}</if>
            <if test="money != null "> and money = #{money}</if>
            <if test="balanceAfter != null "> and balance_after = #{balanceAfter}</if>
            <if test="payTime != null  and payTime != ''"> and pay_time = #{payTime}</if>
            <if test="payResult != null  and payResult != ''"> and pay_result = #{payResult}</if>
        </where>
    </select>

    <select id="selectPhoneBalanceLogById" parameterType="Long" resultMap="PhoneBalanceLogResult">
        <include refid="selectPhoneBalanceLogVo"/>
        where id = #{id}
    </select>

    <insert id="insertPhoneBalanceLog" parameterType="PhoneBalanceLog" useGeneratedKeys="true" keyProperty="id">
        insert into phone_balance_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="companyId != null">company_id,</if>
            <if test="configId != null">config_id,</if>
            <if test="memberId != null">member_id,</if>
            <if test="type != null">type,</if>
            <if test="balanceBefore != null">balance_before,</if>
            <if test="money != null">money,</if>
            <if test="balanceAfter != null">balance_after,</if>
            <if test="payTime != null">pay_time,</if>
            <if test="payResult != null">pay_result,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="companyId != null">#{companyId},</if>
            <if test="configId != null">#{configId},</if>
            <if test="memberId != null">#{memberId},</if>
            <if test="type != null">#{type},</if>
            <if test="balanceBefore != null">#{balanceBefore},</if>
            <if test="money != null">#{money},</if>
            <if test="balanceAfter != null">#{balanceAfter},</if>
            <if test="payTime != null">#{payTime},</if>
            <if test="payResult != null">#{payResult},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePhoneBalanceLog" parameterType="PhoneBalanceLog">
        update phone_balance_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="companyId != null">company_id = #{companyId},</if>
            <if test="configId != null">config_id = #{configId},</if>
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="type != null">type = #{type},</if>
            <if test="balanceBefore != null">balance_before = #{balanceBefore},</if>
            <if test="money != null">money = #{money},</if>
            <if test="balanceAfter != null">balance_after = #{balanceAfter},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="payResult != null">pay_result = #{payResult},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePhoneBalanceLogById" parameterType="Long">
        delete from phone_balance_log where id = #{id}
    </delete>

    <delete id="deletePhoneBalanceLogByIds" parameterType="String">
        delete from phone_balance_log where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>