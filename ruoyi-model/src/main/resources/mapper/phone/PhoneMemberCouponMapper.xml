<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.phone.mapper.PhoneMemberCouponMapper">

    <resultMap type="PhoneMemberCoupon" id="PhoneMemberCouponResult">
        <result property="id"    column="id"    />
        <result property="memberId"    column="member_id"    />
        <result property="companyId"    column="company_id"    />
        <result property="appId"    column="app_id"    />
        <result property="couponId"    column="coupon_id"    />
        <result property="expirationTime"    column="expiration_time"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <association property="wechatConfig"    column="app_id" javaType="WechatConfig" resultMap="WechatConfigResult" />
        <association property="member"    column="member_id" javaType="Member" resultMap="MemberResult" />
        <association property="phoneCoupon"    column="coupon_id" javaType="PhoneCoupon" resultMap="PhoneCouponResult" />
    </resultMap>

    <resultMap type="WechatConfig" id="WechatConfigResult">
        <result property="title"    column="wxTitle"    />
    </resultMap>

    <resultMap type="Member" id="MemberResult">
        <result property="id"    column="member_id"    />
        <result property="name"    column="memberName"    />
        <result property="avatar"    column="memberAvatar"    />
        <result property="number"    column="number"    />
        <result property="mobile"    column="memberMobile"    />
        <result property="sex"    column="sex"    />
        <result property="birthday"    column="birthday"    />
        <result property="balance"    column="balance"    />
        <result property="openId"    column="open_id"    />
        <result property="isMember"    column="is_member"    />
    </resultMap>

    <resultMap type="PhoneCoupon" id="PhoneCouponResult">
        <result property="title"    column="coupon_title"    />
        <result property="termValidity"    column="term_validity"    />
        <result property="rechargeAmount"    column="recharge_amount"    />
        <result property="fullMoney"    column="full_money"    />
        <result property="minusMoney"    column="minus_money"    />
        <result property="distributionMode"    column="distribution_mode"    />
        <result property="number"    column="coupon_number"    />
        <result property="status"    column="coupon_status"    />
    </resultMap>

    <sql id="selectPhoneMemberCouponVo">
        select
            a.id,
            a.member_id,
            a.company_id,
            a.app_id,
            a.coupon_id,
            a.expiration_time,
            a.status,
            a.create_by,
            a.create_time,
            a.update_by,
            a.update_time,
            a.remark,
            wc.title as wxTitle,
            m.name AS memberName,
            m.avatar AS memberAvatar,
            m.number,
            m.mobile AS memberMobile,
            m.sex,
            m.birthday,
            m.balance,
            m.open_id,
            m.is_member,
            a.title as coupon_title,
            a.term_validity,
            a.recharge_amount,
            a.full_money,
            a.minus_money,
            a.distribution_mode,
            a.number as coupon_number,
            a.status as coupon_status
        from phone_member_coupon a
                 left join phone_wechat_config wc ON wc.app_id = a.app_id
                 left join phone_member m ON m.id = a.member_id
                left join phone_coupon c ON c.id = a.coupon_id
    </sql>

    <select id="selectPhoneMemberCouponList" parameterType="PhoneMemberCoupon" resultMap="PhoneMemberCouponResult">
        <include refid="selectPhoneMemberCouponVo"/>
        <where>
            <if test="memberId != null "> and a.member_id = #{memberId}</if>
            <if test="companyId != null "> and a.company_id = #{companyId}</if>
            <if test="appId != null  and appId != ''"> and a.app_id = #{appId}</if>
            <if test="couponId != null "> and a.coupon_id = #{couponId}</if>
            <if test="expirationTime != null "> and a.expiration_time = #{expirationTime}</if>
            <if test="status != null  and status != ''"> and a.status = #{status}</if>
        </where>
        ORDER BY a.create_time DESC
    </select>

    <select id="selectPhoneMemberCouponById" parameterType="Long" resultMap="PhoneMemberCouponResult">
        <include refid="selectPhoneMemberCouponVo"/>
        where a.id = #{id}
    </select>

    <insert id="insertPhoneMemberCoupon" parameterType="PhoneMemberCoupon" useGeneratedKeys="true" keyProperty="id">
        insert into phone_member_coupon
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="memberId != null">member_id,</if>
            <if test="companyId != null">company_id,</if>
            <if test="appId != null">app_id,</if>
            <if test="couponId != null">coupon_id,</if>
            <if test="expirationTime != null">expiration_time,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="memberId != null">#{memberId},</if>
            <if test="companyId != null">#{companyId},</if>
            <if test="appId != null">#{appId},</if>
            <if test="couponId != null">#{couponId},</if>
            <if test="expirationTime != null">#{expirationTime},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePhoneMemberCoupon" parameterType="PhoneMemberCoupon">
        update phone_member_coupon
        <trim prefix="SET" suffixOverrides=",">
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="companyId != null">company_id = #{companyId},</if>
            <if test="appId != null">app_id = #{appId},</if>
            <if test="couponId != null">coupon_id = #{couponId},</if>
            <if test="expirationTime != null">expiration_time = #{expirationTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePhoneMemberCouponById" parameterType="Long">
        delete from phone_member_coupon where id = #{id}
    </delete>

    <delete id="deletePhoneMemberCouponByIds" parameterType="String">
        delete from phone_member_coupon where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>