<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.shop.mapper.BalanceInfoMapper">

    <resultMap type="BalanceInfo" id="BalanceInfoResult">
        <result property="id"    column="id"    />
        <result property="memberId"    column="member_id"    />
        <result property="orderType"    column="order_type"    />
        <result property="orderId"    column="order_id"    />
        <result property="beforeBalance"    column="before_balance"    />
        <result property="balance"    column="balance"    />
        <result property="money"    column="money"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectBalanceInfoVo">
        select
            id,
            member_id,
            order_type,
            order_id,
            before_balance,
            balance,
            money,
            create_by,
            create_time,
            update_by,
            update_time,
            remark
        from shop_balance_info
    </sql>

    <select id="selectBalanceInfoList" parameterType="BalanceInfo" resultMap="BalanceInfoResult">
        <include refid="selectBalanceInfoVo"/>
        <where>
            <if test="memberId != null "> and member_id = #{memberId}</if>
            <if test="orderType != null "> and order_type = #{orderType}</if>
            <if test="orderId != null "> and order_id = #{orderId}</if>
            <if test="beforeBalance != null "> and before_balance = #{beforeBalance}</if>
            <if test="balance != null "> and balance = #{balance}</if>
            <if test="money != null "> and money = #{money}</if>
        </where>
    </select>

    <select id="selectBalanceInfoById" parameterType="Long" resultMap="BalanceInfoResult">
        <include refid="selectBalanceInfoVo"/>
        where id = #{id}
    </select>

    <insert id="insertBalanceInfo" parameterType="BalanceInfo" useGeneratedKeys="true" keyProperty="id">
        insert into shop_balance_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="memberId != null">member_id,</if>
            <if test="orderType != null">order_type,</if>
            <if test="orderId != null">order_id,</if>
            <if test="beforeBalance != null">before_balance,</if>
            <if test="balance != null">balance,</if>
            <if test="money != null">money,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="memberId != null">#{memberId},</if>
            <if test="orderType != null">#{orderType},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="beforeBalance != null">#{beforeBalance},</if>
            <if test="balance != null">#{balance},</if>
            <if test="money != null">#{money},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateBalanceInfo" parameterType="BalanceInfo">
        update shop_balance_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="orderType != null">order_type = #{orderType},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="beforeBalance != null">before_balance = #{beforeBalance},</if>
            <if test="balance != null">balance = #{balance},</if>
            <if test="money != null">money = #{money},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBalanceInfoById" parameterType="Long">
        delete from shop_balance_info where id = #{id}
    </delete>

    <delete id="deleteBalanceInfoByIds" parameterType="String">
        delete from shop_balance_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>