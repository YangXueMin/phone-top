<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.shop.mapper.CardCouponMapper">

    <resultMap type="CardCoupon" id="CardCouponResult">
        <result property="cardId"     column="card_id"      />
        <result property="couponId"     column="coupon_id"      />
        <result property="number"     column="number"      />
        <association property="coupon"    column="coupon_id" javaType="Coupon" resultMap="CouponResult" />
    </resultMap>

    <resultMap type="Coupon" id="CouponResult">
        <result property="id"    column="scId"    />
        <result property="couponName"    column="coupon_name"    />
        <result property="suitRange"    column="suit_range"    />
        <result property="goodsList"    column="goods_list"    />
        <result property="couponType"    column="coupon_type"    />
        <result property="couponStrength"    column="coupon_strength"    />
        <result property="couponStrengthMoney"    column="coupon_strength_money"    />
        <result property="discount"    column="discount"    />
        <result property="termValidity"    column="term_validity"    />
        <result property="number"    column="scNumber"    />
        <result property="limitCollar"    column="limit_collar"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectCardCouponVo">
        select
            cc.card_id,
            cc.coupon_id,
            cc.money,
            cc.number,
            sc.id AS scId,
            sc.coupon_name,
            sc.suit_range,
            sc.goods_list,
            sc.coupon_type,
            sc.coupon_strength,
            sc.coupon_strength_money,
            sc.discount,
            sc.term_validity,
            sc.number AS scNumber,
            sc.limit_collar,
            sc.status,
            sc.create_by,
            sc.create_time,
            sc.update_by,
            sc.update_time
        from shop_card_coupon cc
        left join shop_coupon sc ON cc.coupon_id = sc.id
    </sql>

    <delete id="deleteCardCouponByCardId" parameterType="Long">
        delete from shop_card_coupon where card_id=#{cardId}
    </delete>

    <select id="selectCountCardCouponByCouponId" resultType="Integer">
        select count(1) from shop_card_coupon where coupon_id=#{couponId}
    </select>

    <select id="selectCardCouponByCardId" parameterType="Long" resultMap="CardCouponResult">
        <include refid="selectCardCouponVo"/>
        where cc.card_id = #{cardId}
    </select>

    <delete id="deleteCardCoupon" parameterType="Long">
        delete from shop_card_coupon where card_id in
        <foreach collection="array" item="cardId" open="(" separator="," close=")">
            #{cardId}
        </foreach>
    </delete>

    <insert id="batchCardCoupon">
        insert into shop_card_coupon(card_id, coupon_id,number) values
        <foreach item="item" index="index" collection="list" separator=",">
            (#{item.cardId},#{item.couponId},#{item.number})
        </foreach>
    </insert>

</mapper>