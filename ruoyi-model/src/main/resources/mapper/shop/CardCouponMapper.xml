<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.shop.mapper.CardCouponMapper">

<resultMap type="CardCoupon" id="CardCouponResult">
        <result property="cardId"     column="card_id"      />
        <result property="couponId"     column="coupon_id"      />
        <result property="number"     column="number"      />
    </resultMap>

    <delete id="deleteCardCouponByCardId" parameterType="Long">
        delete from shop_card_coupon where card_id=#{cardId}
    </delete>

    <select id="selectCountCardCouponByCouponId" resultType="Integer">
        select count(1) from shop_card_coupon where coupon_id=#{couponId}
    </select>

    <delete id="deleteCardCoupon" parameterType="Long">
        delete from shop_card_coupon where card_id in
        <foreach collection="array" item="cardId" open="(" separator="," close=")">
            #{cardId}
        </foreach>
    </delete>

    <insert id="batchCardCoupon">
        insert into shop_card_coupon(card_id, coupon_id,number) values
        <foreach item="item" index="index" collection="list" separator=",">
            (#{item.cardId},#{item.couponId},#{item.number})
        </foreach>
    </insert>

</mapper>