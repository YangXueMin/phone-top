<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.shop.mapper.CompanyInfoMapper">

    <resultMap type="CompanyInfo" id="CompanyInfoResult">
        <result property="id"    column="id"    />
        <result property="companyId"    column="company_id"    />
        <result property="logo"    column="logo"    />
        <result property="shortName"    column="short_name"    />
        <result property="phone"    column="phone"    />
        <result property="natural"    column="natural_"    />
        <result property="certificate"    column="certificate"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectCompanyInfoVo">
        select
            id,
            company_id,
            logo,
            short_name,
            phone,
            natural_,
            certificate,
            create_by,
            create_time,
            update_by,
            update_time,
            remark
        from shop_company_info
    </sql>

    <select id="selectCompanyInfoList" parameterType="CompanyInfo" resultMap="CompanyInfoResult">
        <include refid="selectCompanyInfoVo"/>
        <where>
            <if test="companyId != null "> and company_id = #{companyId}</if>
            <if test="logo != null  and logo != ''"> and logo = #{logo}</if>
            <if test="shortName != null  and shortName != ''"> and short_name like concat('%', #{shortName}, '%')</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="natural != null  and natural != ''"> and natural_ = #{natural}</if>
            <if test="certificate != null  and certificate != ''"> and certificate = #{certificate}</if>
        </where>
    </select>

    <select id="selectCompanyInfoById" parameterType="Long" resultMap="CompanyInfoResult">
        <include refid="selectCompanyInfoVo"/>
        where id = #{id}
    </select>

    <select id="selectCompanyInfoByCompanyId" parameterType="Long" resultMap="CompanyInfoResult">
        <include refid="selectCompanyInfoVo"/>
        where company_id = #{companyId}
    </select>

    <insert id="insertCompanyInfo" parameterType="CompanyInfo">
        insert into shop_company_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="companyId != null">company_id,</if>
            <if test="logo != null">logo,</if>
            <if test="shortName != null">short_name,</if>
            <if test="phone != null">phone,</if>
            <if test="natural != null">natural_,</if>
            <if test="certificate != null">certificate,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="companyId != null">#{companyId},</if>
            <if test="logo != null">#{logo},</if>
            <if test="shortName != null">#{shortName},</if>
            <if test="phone != null">#{phone},</if>
            <if test="natural != null">#{natural},</if>
            <if test="certificate != null">#{certificate},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateCompanyInfo" parameterType="CompanyInfo">
        update shop_company_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="companyId != null">company_id = #{companyId},</if>
            <if test="logo != null">logo = #{logo},</if>
            <if test="shortName != null">short_name = #{shortName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="natural != null">natural_ = #{natural},</if>
            <if test="certificate != null">certificate = #{certificate},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCompanyInfoById" parameterType="Long">
        delete from shop_company_info where id = #{id}
    </delete>

    <delete id="deleteCompanyInfoByIds" parameterType="String">
        delete from shop_company_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>