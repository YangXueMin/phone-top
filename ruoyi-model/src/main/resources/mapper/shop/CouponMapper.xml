<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.shop.mapper.CouponMapper">

    <resultMap type="Coupon" id="CouponResult">
        <result property="id"    column="id"    />
        <result property="couponName"    column="coupon_name"    />
        <result property="photo"    column="photo"    />
        <result property="suitRange"    column="suit_range"    />
        <result property="goodsList"    column="goods_list"    />
        <result property="couponType"    column="coupon_type"    />
        <result property="couponStrength"    column="coupon_strength"    />
        <result property="couponStrengthMoney"    column="coupon_strength_money"    />
        <result property="discount"    column="discount"    />
        <result property="termValidity"    column="term_validity"    />
        <result property="number"    column="number"    />
        <result property="limitCollar"    column="limit_collar"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectCouponVo">
        select
            id,
            coupon_name,
            photo,
            suit_range,
            goods_list,
            coupon_type,
            coupon_strength,
            coupon_strength_money,
            discount,
            term_validity,
            number,
            limit_collar,
            status,
            create_by,
            create_time,
            update_by,
            update_time
        from shop_coupon
    </sql>

    <select id="selectCouponList" parameterType="Coupon" resultMap="CouponResult">
        <include refid="selectCouponVo"/>
        <where>
            <if test="couponName != null  and couponName != ''"> and coupon_name like concat('%', #{couponName}, '%')</if>
            <if test="suitRange != null  and suitRange != ''"> and suit_range = #{suitRange}</if>
            <if test="goodsList != null  and goodsList != ''"> and goods_list = #{goodsList}</if>
            <if test="couponType != null  and couponType != ''"> and coupon_type = #{couponType}</if>
            <if test="couponStrength != null "> and coupon_strength = #{couponStrength}</if>
            <if test="couponStrengthMoney != null "> and coupon_strength_money = #{couponStrengthMoney}</if>
            <if test="discount != null "> and discount = #{discount}</if>
            <if test="termValidity != null "> and term_validity = #{termValidity}</if>
            <if test="number != null "> and number = #{number}</if>
            <if test="limitCollar != null "> and limit_collar = #{limitCollar}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by create_time DESC
    </select>

    <select id="selectCouponById" parameterType="Long" resultMap="CouponResult">
        <include refid="selectCouponVo"/>
        where id = #{id}
    </select>

    <insert id="insertCoupon" parameterType="Coupon" useGeneratedKeys="true" keyProperty="id">
        insert into shop_coupon
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="couponName != null">coupon_name,</if>
            <if test="photo != null">photo,</if>
            <if test="suitRange != null">suit_range,</if>
            <if test="goodsList != null">goods_list,</if>
            <if test="couponType != null">coupon_type,</if>
            <if test="couponStrength != null">coupon_strength,</if>
            <if test="couponStrengthMoney != null">coupon_strength_money,</if>
            <if test="discount != null">discount,</if>
            <if test="termValidity != null">term_validity,</if>
            <if test="number != null">number,</if>
            <if test="limitCollar != null">limit_collar,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="couponName != null">#{couponName},</if>
            <if test="photo != null">#{photo},</if>
            <if test="suitRange != null">#{suitRange},</if>
            <if test="goodsList != null">#{goodsList},</if>
            <if test="couponType != null">#{couponType},</if>
            <if test="couponStrength != null">#{couponStrength},</if>
            <if test="couponStrengthMoney != null">#{couponStrengthMoney},</if>
            <if test="discount != null">#{discount},</if>
            <if test="termValidity != null">#{termValidity},</if>
            <if test="number != null">#{number},</if>
            <if test="limitCollar != null">#{limitCollar},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateCoupon" parameterType="Coupon">
        update shop_coupon
        <trim prefix="SET" suffixOverrides=",">
            <if test="couponName != null">coupon_name = #{couponName},</if>
            <if test="photo != null">photo = #{photo},</if>
            <if test="suitRange != null">suit_range = #{suitRange},</if>
            <if test="goodsList != null">goods_list = #{goodsList},</if>
            <if test="couponType != null">coupon_type = #{couponType},</if>
            <if test="couponStrength != null">coupon_strength = #{couponStrength},</if>
            <if test="couponStrengthMoney != null">coupon_strength_money = #{couponStrengthMoney},</if>
            <if test="discount != null">discount = #{discount},</if>
            <if test="termValidity != null">term_validity = #{termValidity},</if>
            <if test="number != null">number = #{number},</if>
            <if test="limitCollar != null">limit_collar = #{limitCollar},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCouponById" parameterType="Long">
        delete from shop_coupon where id = #{id}
    </delete>

    <delete id="deleteCouponByIds" parameterType="String">
        delete from shop_coupon where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>