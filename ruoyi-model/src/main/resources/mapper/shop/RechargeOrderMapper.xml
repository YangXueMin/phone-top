<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.shop.mapper.RechargeOrderMapper">

    <resultMap type="RechargeOrder" id="RechargeOrderResult">
        <result property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="memberId" column="member_id"/>
        <result property="cardId" column="card_id"/>
        <result property="money" column="money"/>
        <result property="wechatOrder" column="wechat_order"/>
        <result property="orderStatus"    column="order_status"    />
        <result property="payType"    column="pay_type"    />
        <result property="payTime"    column="pay_time"    />
        <result property="payResult"    column="pay_result"    />
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <association property="shopCard"    column="card_id" javaType="ShopCard" resultMap="ShopCardResult" />
        <association property="member"    column="member_id" javaType="Member" resultMap="MemberResult" />
    </resultMap>

    <resultMap type="ShopCard" id="ShopCardResult">
        <result property="id"    column="card_id"    />
        <result property="title"    column="title"    />
        <result property="money"    column="money"    />
        <result property="picture"    column="picture"    />
        <result property="content"    column="content"    />
        <result property="status"    column="status"    />
    </resultMap>

    <resultMap type="Member" id="MemberResult">
        <result property="id"    column="member_id"    />
        <result property="name"    column="memberName"    />
        <result property="avatar"    column="memberAvatar"    />
        <result property="number"    column="number"    />
        <result property="mobile"    column="memberMobile"    />
        <result property="sex"    column="sex"    />
        <result property="birthday"    column="birthday"    />
        <result property="balance"    column="balance"    />
        <result property="openId"    column="open_id"    />
        <result property="isMember"    column="is_member"    />
        <result property="userId"    column="memberUserId"    />
    </resultMap>

    <sql id="selectRechargeOrderVo">
        select a.id,
               a.order_no,
               a.member_id,
               a.card_id,
               a.money,
               a.wechat_order,
               a.order_status,
               a.pay_type,
               a.pay_time,
               a.pay_result,
               a.create_by,
               a.create_time,
               a.update_by,
               a.update_time,
               c.title,
               c.money,
               c.picture,
               c.content,
               c.status,
               m.name AS memberName,
               m.avatar AS memberAvatar,
               m.number,
               m.mobile AS memberMobile,
               m.sex,
               m.birthday,
               m.balance,
               m.open_id,
               m.is_member,
               m.user_id AS memberUserId
        from shop_recharge_order a
        left join shop_card c ON a.card_id = c.id
        left join shop_member m ON m.id = a.member_id
    </sql>

    <select id="selectRechargeOrderList" parameterType="RechargeOrder" resultMap="RechargeOrderResult">
        <include refid="selectRechargeOrderVo"/>
        <where>
            <if test="orderNo != null  and orderNo != ''">and a.order_no = #{orderNo}</if>
            <if test="memberId != null ">and a.member_id = #{memberId}</if>
            <if test="cardId != null ">and a.card_id = #{cardId}</if>
            <if test="money != null ">and a.money = #{money}</if>
            <if test="wechatOrder != null  and wechatOrder != ''">and a.wechat_order = #{wechatOrder}</if>
            <if test="orderStatus != null  and orderStatus != ''"> and a.order_status = #{orderStatus}</if>
            <if test="payType != null  and payType != ''"> and a.pay_type = #{payType}</if>
        </where>
        order by a.create_time DESC
    </select>

    <select id="selectRechargeOrderById" parameterType="Long" resultMap="RechargeOrderResult">
        <include refid="selectRechargeOrderVo"/>
        where a.id = #{id}
    </select>

    <select id="selectOrderByOrderNo" parameterType="string" resultMap="RechargeOrderResult">
        <include refid="selectRechargeOrderVo"/>
        where order_no = #{orderNo}
    </select>

    <insert id="insertRechargeOrder" parameterType="RechargeOrder" useGeneratedKeys="true" keyProperty="id">
        insert into shop_recharge_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNo != null">order_no,</if>
            <if test="memberId != null">member_id,</if>
            <if test="cardId != null">card_id,</if>
            <if test="money != null">money,</if>
            <if test="wechatOrder != null">wechat_order,</if>
            <if test="orderStatus != null">order_status,</if>
            <if test="payType != null">pay_type,</if>
            <if test="payTime != null">pay_time,</if>
            <if test="payResult != null">pay_result,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null">#{orderNo},</if>
            <if test="memberId != null">#{memberId},</if>
            <if test="cardId != null">#{cardId},</if>
            <if test="money != null">#{money},</if>
            <if test="wechatOrder != null">#{wechatOrder},</if>
            <if test="orderStatus != null">#{orderStatus},</if>
            <if test="payType != null">#{payType},</if>
            <if test="payTime != null">#{payTime},</if>
            <if test="payResult != null">#{payResult},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateRechargeOrder" parameterType="RechargeOrder">
        update shop_recharge_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="cardId != null">card_id = #{cardId},</if>
            <if test="money != null">money = #{money},</if>
            <if test="wechatOrder != null">wechat_order = #{wechatOrder},</if>
            <if test="orderStatus != null">order_status = #{orderStatus},</if>
            <if test="payType != null">pay_type = #{payType},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="payResult != null">pay_result = #{payResult},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteRechargeOrderById" parameterType="Long">
        delete
        from shop_recharge_order
        where id = #{id}
    </delete>

    <delete id="deleteRechargeOrderByIds" parameterType="String">
        delete from shop_recharge_order where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>