<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.shop.mapper.ShopActivityGoodsMapper">

    <resultMap type="ShopActivityGoods" id="ShopActivityGoodsResult">
        <result property="id" column="id"/>
        <result property="activityId" column="activity_id"/>
        <result property="goodsId" column="goods_id"/>
        <result property="specsId" column="specs_id"/>
        <result property="buyingPrice" column="buying_price"/>
        <result property="buyingNumber" column="buying_number"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <association property="goods"    column="goods_id" javaType="Coupon" resultMap="GoodsResult" />
    </resultMap>

    <resultMap type="Goods" id="GoodsResult">
        <result property="companyGoodsId"    column="company_goods_id"    />
        <result property="shopId"    column="shop_id"    />
        <result property="name"    column="name"    />
        <result property="describe"    column="describe_"    />
        <result property="classId"    column="class_id"    />
        <result property="goodsLabel"    column="goods_label"    />
        <result property="pictures"    column="pictures"    />
        <result property="attributeList"    column="attribute_list"    />
        <result property="deliveryType"    column="delivery_type"    />
        <result property="isLimit"    column="is_limit"    />
        <result property="limitType"    column="limit_type"    />
        <result property="limitNum"    column="limit_num"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectShopActivityGoodsVo">
        select a.id,
               a.activity_id,
               a.goods_id,
               a.specs_id,
               a.buying_price,
               a.buying_number,
               a.create_by,
               a.create_time,
               a.update_by,
               a.update_time,
               a.remark,
               sg.company_goods_id,
               sg.shop_id,
               sg.name,
               sg.describe_,
               sg.class_id,
               sg.goods_label,
               sg.pictures,
               sg.attribute_list,
               sg.delivery_type,
               sg.is_limit,
               sg.limit_type,
               sg.limit_num,
               sg.status
        from shop_activity_goods a
        left join shop_goods sg ON sg.id = a.goods_id
    </sql>

    <select id="selectShopActivityGoodsList" parameterType="ShopActivityGoods" resultMap="ShopActivityGoodsResult">
        <include refid="selectShopActivityGoodsVo"/>
        <where>
            <if test="activityId != null ">and a.activity_id = #{activityId}</if>
            <if test="goodsId != null ">and a.goods_id = #{goodsId}</if>
            <if test="specsId != null ">and a.specs_id = #{specsId}</if>
            <if test="buyingPrice != null ">and a.buying_price = #{buyingPrice}</if>
            <if test="buyingNumber != null ">and a.buying_number = #{buyingNumber}</if>
        </where>
        order by a.create_time DESC
    </select>

    <select id="selectShopActivityGoodsById" parameterType="Long" resultMap="ShopActivityGoodsResult">
        <include refid="selectShopActivityGoodsVo"/>
        where a.id = #{id}
    </select>

    <insert id="insertShopActivityGoods" parameterType="ShopActivityGoods" useGeneratedKeys="true" keyProperty="id">
        insert into shop_activity_goods
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="activityId != null">activity_id,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="specsId != null">specs_id,</if>
            <if test="buyingPrice != null">buying_price,</if>
            <if test="buyingNumber != null">buying_number,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="activityId != null">#{activityId},</if>
            <if test="goodsId != null">#{goodsId},</if>
            <if test="specsId != null">#{specsId},</if>
            <if test="buyingPrice != null">#{buyingPrice},</if>
            <if test="buyingNumber != null">#{buyingNumber},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateShopActivityGoods" parameterType="ShopActivityGoods">
        update shop_activity_goods
        <trim prefix="SET" suffixOverrides=",">
            <if test="activityId != null">activity_id = #{activityId},</if>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="specsId != null">specs_id = #{specsId},</if>
            <if test="buyingPrice != null">buying_price = #{buyingPrice},</if>
            <if test="buyingNumber != null">buying_number = #{buyingNumber},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteShopActivityGoodsById" parameterType="Long">
        delete
        from shop_activity_goods
        where id = #{id}
    </delete>

    <delete id="deleteShopActivityGoodsByIds" parameterType="String">
        delete from shop_activity_goods where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteShopActivityGoodsByActivityId" parameterType="Long">
        delete
        from shop_activity_goods
        where activity_id = #{activityId}
    </delete>

    <delete id="deleteShopActivityGoodsByActivityIds" parameterType="String">
        delete from shop_activity_goods where activity_id in
        <foreach item="activityId" collection="array" open="(" separator="," close=")">
            #{activityId}
        </foreach>
    </delete>
</mapper>