<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.shop.mapper.ShopActivityMapper">

    <resultMap type="ShopActivity" id="ShopActivityResult">
        <result property="id" column="id"/>
        <result property="activityName" column="activity_name"/>
        <result property="shopId" column="shop_id"/>
        <result property="beginDate" column="begin_date"/>
        <result property="activityTime" column="activity_time"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectShopActivityVo">
        select id,
               activity_name,
               shop_id,
               begin_date,
               activity_time,
               status,
               create_by,
               create_time,
               update_by,
               update_time,
               remark
        from shop_activity
    </sql>

    <select id="selectShopActivityList" parameterType="ShopActivity" resultMap="ShopActivityResult">
        <include refid="selectShopActivityVo"/>
        <where>
            <if test="activityName != null  and activityName != ''">and activity_name like concat('%', #{activityName},
                '%')
            </if>
            <if test="shopId != null ">and shop_id = #{shopId}</if>
            <if test="beginDate != null ">and begin_date = #{beginDate}</if>
            <if test="activityTime != null ">and activity_time = #{activityTime}</if>
            <if test="status != null  and status != ''">and status = #{status}</if>
        </where>
    </select>

    <select id="selectShopActivityById" parameterType="Long" resultMap="ShopActivityResult">
        <include refid="selectShopActivityVo"/>
        where id = #{id}
    </select>

    <insert id="insertShopActivity" parameterType="ShopActivity">
        insert into shop_activity
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="activityName != null">activity_name,</if>
            <if test="shopId != null">shop_id,</if>
            <if test="beginDate != null">begin_date,</if>
            <if test="activityTime != null">activity_time,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="activityName != null">#{activityName},</if>
            <if test="shopId != null">#{shopId},</if>
            <if test="beginDate != null">#{beginDate},</if>
            <if test="activityTime != null">#{activityTime},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateShopActivity" parameterType="ShopActivity">
        update shop_activity
        <trim prefix="SET" suffixOverrides=",">
            <if test="activityName != null">activity_name = #{activityName},</if>
            <if test="shopId != null">shop_id = #{shopId},</if>
            <if test="beginDate != null">begin_date = #{beginDate},</if>
            <if test="activityTime != null">activity_time = #{activityTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteShopActivityById" parameterType="Long">
        delete
        from shop_activity
        where id = #{id}
    </delete>

    <delete id="deleteShopActivityByIds" parameterType="String">
        delete from shop_activity where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>