<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.shop.mapper.ShopActivityMapper">

    <resultMap type="ShopActivity" id="ShopActivityResult">
        <result property="id" column="id"/>
        <result property="activityName" column="activity_name"/>
        <result property="shopId" column="shop_id"/>
        <result property="shopName" column="shop_name_longitude_latitude"/>
        <result property="beginDate" column="begin_date"/>
        <result property="activityTime" column="activity_time"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <association property="shopInfo"    column="shop_id" javaType="ShopInfo" resultMap="ShopInfoResult" />
    </resultMap>

    <resultMap type="ShopInfo" id="ShopInfoResult">
        <result property="id"    column="shop_id"    />
        <result property="name"    column="name"    />
        <result property="province"    column="province"    />
        <result property="city"    column="city"    />
        <result property="county"    column="county"    />
        <result property="address"    column="address"    />
        <result property="longitude"    column="longitude"    />
        <result property="latitude"    column="latitude"    />
        <result property="mobile"    column="mobile"    />
        <result property="businessHours"    column="business_hours"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="distributionMode"    column="distribution_mode"    />
        <result property="isActivity"    column="is_activity"    />
        <result property="isSyncShop"    column="is_sync_shop"    />
        <result property="isSyncNatural"    column="is_sync_natural"    />
        <result property="securityFile"    column="security_file"    />
        <result property="naturalFile"    column="natural_file"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectShopActivityVo">
        select a.id,
               a.activity_name,
               a.shop_id,
               a.begin_date,
               a.activity_time,
               a.status,
               a.create_by,
               a.create_time,
               a.update_by,
               a.update_time,
               a.remark,
               CONCAT_WS(',', s.name, s.longitude,s.latitude) AS shop_name_longitude_latitude,
               s.name,
               s.province,
               s.city,
               s.county,
               s.address,
               s.longitude,
               s.latitude,
               s.mobile,
               s.business_hours,
               s.start_time,
               s.end_time,
               s.distribution_mode,
               s.is_activity,
               s.is_sync_shop,
               s.is_sync_natural,
               s.security_file,
               s.natural_file,
               s.status
        from shop_activity a
        left join shop_info s ON a.shop_id = s.id
    </sql>

    <select id="selectShopActivityList" parameterType="ShopActivity" resultMap="ShopActivityResult">
        <include refid="selectShopActivityVo"/>
        <where>
            <if test="activityName != null  and activityName != ''">and a.activity_name like concat('%', #{activityName},'%')
            </if>
            <if test="shopId != null ">and a.shop_id = #{shopId}</if>
            <if test="beginDate != null ">and a.begin_date = #{beginDate}</if>
            <if test="activityTime != null ">and a.activity_time = #{activityTime}</if>
            <if test="status != null  and status != ''">and a.status = #{status}</if>
        </where>
        order by a.create_time DESC
    </select>

    <select id="selectShopActivityById" parameterType="Long" resultMap="ShopActivityResult">
        <include refid="selectShopActivityVo"/>
        where a.id = #{id}
    </select>

    <insert id="insertShopActivity" parameterType="ShopActivity" useGeneratedKeys="true" keyProperty="id">
        insert into shop_activity
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="activityName != null">activity_name,</if>
            <if test="shopId != null">shop_id,</if>
            <if test="beginDate != null">begin_date,</if>
            <if test="activityTime != null">activity_time,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="activityName != null">#{activityName},</if>
            <if test="shopId != null">#{shopId},</if>
            <if test="beginDate != null">#{beginDate},</if>
            <if test="activityTime != null">#{activityTime},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateShopActivity" parameterType="ShopActivity">
        update shop_activity
        <trim prefix="SET" suffixOverrides=",">
            <if test="activityName != null">activity_name = #{activityName},</if>
            <if test="shopId != null">shop_id = #{shopId},</if>
            <if test="beginDate != null">begin_date = #{beginDate},</if>
            <if test="activityTime != null">activity_time = #{activityTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteShopActivityById" parameterType="Long">
        delete
        from shop_activity
        where id = #{id}
    </delete>

    <delete id="deleteShopActivityByIds" parameterType="String">
        delete from shop_activity where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>