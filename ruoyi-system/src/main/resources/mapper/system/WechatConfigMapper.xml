<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.WechatConfigMapper">

    <resultMap type="WechatConfig" id="WechatConfigResult">
        <result property="id"    column="id"    />
        <result property="deptId"    column="dept_id"    />
        <result property="title"    column="title"    />
        <result property="appId"    column="app_id"    />
        <result property="appSecret"    column="app_secret"    />
        <result property="token"    column="token"    />
        <result property="aesKey"    column="aes_key"    />
        <result property="mchId"    column="mch_id"    />
        <result property="mchKey"    column="mch_key"    />
        <result property="keyPath"    column="key_path"    />
        <result property="validityPeriod"    column="validity_period"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectWechatConfigVo">
        select
            a.id,
            a.dept_id,
            a.title,
            a.app_id,
            a.app_secret,
            a.token,
            a.aes_key,
            a.mch_id,
            a.mch_key,
            a.key_path,
               a.validity_period,
               a.status,
            a.create_by,
            a.create_time,
            a.update_by,
            a.update_time,
            a.remark
        from phone_wechat_config a
                 left join sys_dept d on a.dept_id = d.dept_id
    </sql>

    <select id="selectWechatConfigList" parameterType="WechatConfig" resultMap="WechatConfigResult">
        <include refid="selectWechatConfigVo"/>
        <where>
            <if test="deptId != null "> and a.dept_id = #{deptId}</if>
            <if test="title != null  and title != ''"> and a.title = #{title}</if>
            <if test="appId != null  and appId != ''"> and a.app_id = #{appId}</if>
            <if test="appSecret != null  and appSecret != ''"> and a.app_secret = #{appSecret}</if>
            <if test="token != null  and token != ''"> and a.token = #{token}</if>
            <if test="aesKey != null  and aesKey != ''"> and a.aes_key = #{aesKey}</if>
            <if test="mchId != null  and mchId != ''"> and a.mch_id = #{mchId}</if>
            <if test="mchKey != null  and mchKey != ''"> and a.mch_key = #{mchKey}</if>
            <if test="keyPath != null  and keyPath != ''"> and a.key_path = #{keyPath}</if>
            <if test="validityPeriod != null "> and a.validity_period = #{validityPeriod}</if>
            <if test="status != null  and status != ''"> and a.status = #{status}</if>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>
    </select>

    <select id="selectWechatConfigById" parameterType="Long" resultMap="WechatConfigResult">
        <include refid="selectWechatConfigVo"/>
        where a.id = #{id}
    </select>

    <insert id="insertWechatConfig" parameterType="WechatConfig" useGeneratedKeys="true" keyProperty="id">
        insert into phone_wechat_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deptId != null">dept_id,</if>
            <if test="title != null">title,</if>
            <if test="appId != null">app_id,</if>
            <if test="appSecret != null">app_secret,</if>
            <if test="token != null">token,</if>
            <if test="aesKey != null">aes_key,</if>
            <if test="mchId != null">mch_id,</if>
            <if test="mchKey != null">mch_key,</if>
            <if test="keyPath != null">key_path,</if>
            <if test="validityPeriod != null">validity_period,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deptId != null">#{deptId},</if>
            <if test="title != null">#{title},</if>
            <if test="appId != null">#{appId},</if>
            <if test="appSecret != null">#{appSecret},</if>
            <if test="token != null">#{token},</if>
            <if test="aesKey != null">#{aesKey},</if>
            <if test="mchId != null">#{mchId},</if>
            <if test="mchKey != null">#{mchKey},</if>
            <if test="keyPath != null">#{keyPath},</if>
            <if test="validityPeriod != null">#{validityPeriod},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateWechatConfig" parameterType="WechatConfig">
        update phone_wechat_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="appId != null">app_id = #{appId},</if>
            <if test="appSecret != null">app_secret = #{appSecret},</if>
            <if test="token != null">token = #{token},</if>
            <if test="aesKey != null">aes_key = #{aesKey},</if>
            <if test="mchId != null">mch_id = #{mchId},</if>
            <if test="mchKey != null">mch_key = #{mchKey},</if>
            <if test="keyPath != null">key_path = #{keyPath},</if>
            <if test="validityPeriod != null">validity_period = #{validityPeriod},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWechatConfigById" parameterType="Long">
        delete from phone_wechat_config where id = #{id}
    </delete>

    <delete id="deleteWechatConfigByIds" parameterType="String">
        delete from phone_wechat_config where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>