<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysUserShopMapper">

	<resultMap type="SysUserShop" id="SysUserPostResult">
		<result property="userId"     column="user_id"      />
		<result property="shopId"     column="shop_id"      />
	</resultMap>

	<delete id="deleteUserShopByUserId" parameterType="Long">
		delete from sys_user_shop where user_id=#{userId}
	</delete>
	
	<select id="countUserShopById" resultType="Integer">
	    select count(1) from sys_user_shop where shop_id=#{shopId}
	</select>

	<select id="findUserIdsByShopId" resultType="Long">
	    select user_id from sys_user_shop where shop_id=#{shopId}
	</select>

	<select id="findShopIdsByUserId" resultType="Long">
	    select shop_id from sys_user_shop where user_id=#{userId}
	</select>
	
	<delete id="deleteUserShop" parameterType="Long">
 		delete from sys_user_shop where user_id in
 		<foreach collection="array" item="userId" open="(" separator="," close=")">
 			#{userId}
        </foreach> 
 	</delete>
	
	<insert id="batchUserShop">
		insert into sys_user_shop(user_id, shop_id) values
		<foreach item="item" index="index" collection="list" separator=",">
			(#{item.userId},#{item.shopId})
		</foreach>
	</insert>
	
</mapper> 